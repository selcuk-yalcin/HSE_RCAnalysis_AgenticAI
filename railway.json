{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "api/**",
      "agents/**",
      "tasks/**",
      "shared/**",
      "hitl_test/**",
      "rag_pipeline/**",
      "celery_app.py",
      "Dockerfile",
      "requirements-railway.txt",
      "railway.json",
      "railway.toml"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
