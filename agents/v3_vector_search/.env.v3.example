# V3 Vector Search Environment Variables
# .env dosyanıza bu değişkenleri ekleyin veya bu dosyayı .env.v3 olarak kopyalayın

# ─────────────────────────────────────────────────────────────
# VECTOR SEARCH (Opsiyonel - false ise dictionary kullanılır)
# ─────────────────────────────────────────────────────────────
USE_VECTOR_SEARCH=true

# ─────────────────────────────────────────────────────────────
# MONGODB ATLAS
# ─────────────────────────────────────────────────────────────
# Kurulum: https://www.mongodb.com/cloud/atlas/register
# Free M0 tier yeterli
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/hsg245_kb?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────
# OPENROUTER (Embedding için)
# ─────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# MEVCUT KEYS (Değişmedi)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
