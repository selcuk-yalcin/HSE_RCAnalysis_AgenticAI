# V3 Async Orchestrator - Environment Variables
# .env dosyanıza bu değişkenleri ekleyin

# ─────────────────────────────────────────────────────────────
# REDIS (Message Broker + Knowledge Cache)
# ─────────────────────────────────────────────────────────────
# Local development
REDIS_URL=redis://localhost:6379/0

# Railway production
# REDIS_URL=${{Redis.REDIS_URL}}

# Redis Cache Config
USE_REDIS_CACHE=true  # Knowledge base için Redis cache kullan
CACHE_TTL=3600  # Cache timeout (saniye) - Default: 1 saat

# ─────────────────────────────────────────────────────────────
# MONGODB (Vector Search + Job Tracking)
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hsg245_kb?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────
# VECTOR SEARCH (Opsiyonel)
# ─────────────────────────────────────────────────────────────
USE_VECTOR_SEARCH=false  # İlk test için false
# USE_VECTOR_SEARCH=true  # Production'da true

# ─────────────────────────────────────────────────────────────
# API KEYS
# ─────────────────────────────────────────────────────────────
# OpenRouter (Embeddings + Claude API)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Direct Claude API - opsiyonel)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# CELERY WORKER CONFIG
# ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10  # Paralel task sayısı (10 rapor aynı anda)
WORKER_MAX_TASKS_PER_CHILD=50  # Worker restart threshold (memory leak önleme)

# ─────────────────────────────────────────────────────────────
# FASTAPI CONFIG
# ─────────────────────────────────────────────────────────────
PORT=8000
API_BASE_URL=http://localhost:8000  # Production'da Railway URL

# ─────────────────────────────────────────────────────────────
# MONITORING (Opsiyonel)
# ─────────────────────────────────────────────────────────────
# Sentry (Error tracking)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Datadog (APM)
# DD_API_KEY=xxxxx
# DD_SITE=datadoghq.com

# ─────────────────────────────────────────────────────────────
# CORS (Production'da kısıtla)
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*  # Development: *  |  Production: https://yourapp.com

# ─────────────────────────────────────────────────────────────
# TASK TIMEOUTS
# ─────────────────────────────────────────────────────────────
TASK_TIME_LIMIT=1800  # 30 dakika hard limit
TASK_SOFT_TIME_LIMIT=1500  # 25 dakika soft limit
